{
    "alias": "okta",
    "displayName": "Okta",
    "providerId": "saml",
    "enabled": true,
    "updateProfileFirstLoginMode": "on",
    "trustEmail": true,
    "storeToken": false,
    "addReadTokenRoleOnCreate": false,
    "authenticateByDefault": false,
    "linkOnly": false,
    "firstBrokerLoginFlowAlias": "first broker login",
    "config": {
        "singleSignOnServiceUrl": "https://${OKTA_ORG_DOMAIN}/app/${OKTA_APP_ID}/sso/saml",
        "singleLogoutServiceUrl": "https://${OKTA_ORG_DOMAIN}/app/${OKTA_APP_ID}/slo/saml",
        "backchannelSupported": "false",
        "postBindingAuthnRequest": "true",
        "postBindingResponse": "true",
        "postBindingLogout": "true",
        "wantAuthnRequestsSigned": "true",
        "wantAssertionsSigned": "true",
        "wantAssertionsEncrypted": "false",
        "forceAuthn": "false",
        "validateSignature": "true",
        "signingCertificate": "${OKTA_SIGNING_CERT}",
        "signatureAlgorithm": "RSA_SHA256",
        "xmlSigKeyInfoKeyNameTransformer": "KEY_ID",
        "nameIDPolicyFormat": "urn:oasis:names: tc:SAML:1.1:nameid-format:emailAddress",
        "principalType": "SUBJECT",
        "principalAttribute": "email",
        "allowCreate": "true",
        "entityId": "https://api.insightx.example.com/auth/realms/insightx",
        "authnContextClassRefs": "[\"urn:oasis:names:tc:SAML:2.0:ac:classes:PasswordProtectedTransport\"]",
        "authnContextComparisonType": "exact",
        "syncMode": "IMPORT",
        "guiOrder": "2"
    }
}