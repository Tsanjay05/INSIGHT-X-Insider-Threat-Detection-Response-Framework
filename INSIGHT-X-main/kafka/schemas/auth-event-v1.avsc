{
  "type": "record",
  "name": "AuthEvent",
  "namespace": "com.insightx.events",
  "doc": "Authentication event schema for login/logout/MFA activities",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "Unique event identifier (UUID)"
    },
    {
      "name": "timestamp",
      "type": "long",
      "logicalType": "timestamp-millis",
      "doc": "Event timestamp in milliseconds since epoch"
    },
    {
      "name": "user_id",
      "type": "string",
      "doc": "User identifier"
    },
    {
      "name": "username",
      "type": ["null", "string"],
      "default": null,
      "doc": "Username (if available)"
    },
    {
      "name": "source_system",
      "type": "string",
      "doc": "Source system (Okta, Azure AD, etc.)"
    },
    {
      "name": "event_type",
      "type": {
        "type": "enum",
        "name": "AuthEventType",
        "symbols": [
          "LOGIN_SUCCESS",
          "LOGIN_FAILURE",
          "LOGOUT",
          "MFA_SUCCESS",
          "MFA_FAILURE",
          "PASSWORD_CHANGE",
          "PASSWORD_RESET",
          "SESSION_TIMEOUT",
          "ACCOUNT_LOCKED",
          "ACCOUNT_UNLOCKED"
        ]
      },
      "doc": "Type of authentication event"
    },
    {
      "name": "source_ip",
      "type": ["null", "string"],
      "default": null,
      "doc": "Source IP address"
    },
    {
      "name": "user_agent",
      "type": ["null", "string"],
      "default": null,
      "doc": "User agent string"
    },
    {
      "name": "location",
      "type": ["null", {
        "type": "record",
        "name": "GeoLocation",
        "fields": [
          {"name": "country", "type": ["null", "string"], "default": null},
          {"name": "city", "type": ["null", "string"], "default": null},
          {"name": "latitude", "type": ["null", "double"], "default": null},
          {"name": "longitude", "type": ["null", "double"], "default": null}
        ]
      }],
      "default": null,
      "doc": "Geographic location"
    },
    {
      "name": "device_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "Device identifier"
    },
    {
      "name": "mfa_method",
      "type": ["null", {
        "type": "enum",
        "name": "MfaMethod",
        "symbols": ["TOTP", "SMS", "EMAIL", "PUSH", "WEBAUTHN"]
      }],
      "default": null,
      "doc": "MFA method used (if applicable)"
    },
    {
      "name": "risk_score",
      "type": ["null", "double"],
      "default": null,
      "doc": "Risk score from IdP (0.0 - 1.0)"
    },
    {
      "name": "metadata",
      "type": {
        "type": "map",
        "values": "string"
      },
      "default": {},
      "doc": "Additional metadata as key-value pairs"
    }
  ]
}
