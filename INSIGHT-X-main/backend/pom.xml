<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>
    <groupId>com.insightx</groupId>
    <artifactId>insightx-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>INSIGHT-X Backend Parent</name>
    <description>INSIGHT-X backend services parent POM</description>
    <properties>
        <java.version>21</java.version>
    </properties>
    <modules>
        <module>insightx-common</module>
        <module>insightx-ingestion</module>
        <module>insightx-trust-engine</module>
        <module>insightx-intent</module>
        <module>insightx-graph</module>
        <module>insightx-controls</module>
        <module>insightx-provenance</module>
        <module>insightx-api-gateway</module>
        <module>insightx-stream-gateway</module>
    </modules>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.2</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <docker.host>npipe:////./pipe/docker_cli</docker.host>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
