{
    "policy": "insightx-policy-decisions-policy",
    "body": {
        "policy": {
            "phases": {
                "hot": {
                    "min_age": "0ms",
                    "actions": {
                        "rollover": {
                            "max_primary_shard_size": "30GB",
                            "max_age": "3d",
                            "max_docs": 50000000
                        },
                        "set_priority": {
                            "priority": 100
                        }
                    }
                },
                "warm": {
                    "min_age": "3d",
                    "actions": {
                        "shrink": {
                            "number_of_shards": 1
                        },
                        "forcemerge": {
                            "max_num_segments": 1
                        },
                        "set_priority": {
                            "priority": 50
                        }
                    }
                },
                "cold": {
                    "min_age": "30d",
                    "actions": {
                        "searchable_snapshot": {
                            "snapshot_repository": "insightx-snapshots"
                        }
                    }
                },
                "delete": {
                    "min_age": "180d",
                    "actions": {
                        "delete": {}
                    }
                }
            }
        }
    }
}