            "h5": {
                "size": "16px",
                "lineHeight": "1.5",
                "fontWeight": "500",
                "letterSpacing": "0"
            },
            "body": {
                "size": "14px",
                "lineHeight": "1.5",
                "fontWeight": "400",
                "letterSpacing": "0"
            },
            "bodySmall": {
                "size": "12px",
                "lineHeight": "1.4",
                "fontWeight": "400",
                "letterSpacing": "0"
            },
            "caption": {
                "size": "11px",
                "lineHeight": "1.3",
                "fontWeight": "400",
                "letterSpacing": "0"
            }
        },
        "fontWeight": {
            "regular": "400",
            "medium": "500",
            "semibold": "600",
            "bold": "700"
        }
