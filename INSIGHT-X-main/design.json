    "charts": {
        "line": {
            "strokeWidth": "2px",
            "gridStroke": "rgba(255, 255, 255, 0.05)",
            "axisLabelSize": "11px",
            "axisLabelColor": "#9E9EA7"
        },
        "tooltip": {
            "background": "#1C1C1E",
            "border": "1px solid rgba(255, 255, 255, 0.18)",
            "borderRadius": "6px",
            "padding": "8px 12px",
            "boxShadow": "0 16px 32px rgba(0, 0, 0, 0.6)"
        },
        "gradients": {
            "trustPositive": {
                "from": "rgba(48, 240, 179, 0.3)",
                "to": "rgba(48, 240, 179, 0.0)"
            },
            "trustNegative": {
                "from": "rgba(255, 92, 92, 0.3)",
                "to": "rgba(255, 92, 92, 0.0)"
            }
        }
    },
    "states": {
        "loading": {
            "skeleton": {
                "background": "linear-gradient(90deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.1) 50%, rgba(255, 255, 255, 0.05) 100%)",
                "backgroundSize": "200% 100%",
                "animation": "shimmer 1.5s infinite",
                "borderRadius": "4px"
            },
            "spinner": {
                "size": {
                    "small": "20px",
                    "medium": "32px",
                    "large": "48px"
                },
                "color": "#306FFF",
                "animation": "rotate 800ms linear infinite"
            }
        },
        "empty": {
            "iconSize": "64px",
            "iconColor": "#48484D",
            "titleSize": "18px",
            "titleWeight": "600",
            "titleColor": "#C4C4CC",
            "descriptionSize": "14px",
            "descriptionColor": "#6E6E73"
        },
        "error": {
            "iconColor": "#FF5C5C",
            "titleSize": "18px",
            "titleWeight": "600",
            "titleColor": "#FF5C5C"
        }
    },
    "accessibility": {
        "focusOutline": {
            "width": "2px",
            "color": "#306FFF",
            "offset": "2px",
            "style": "solid"
        },
        "contrast": {
            "minimumRatio": {
                "normalText": "4.5:1",
                "largeText": "3:1",
                "interactive": "3:1"
            }
        }
    }
