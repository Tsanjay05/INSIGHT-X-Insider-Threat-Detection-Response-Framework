                "-apple-system",
                "sans-serif"
            ],
            "mono": [
                "JetBrains Mono",
                "Consolas",
                "Monaco",
                "monospace"
            ]
        },
        "fontSize": {
            "h1": {
                "size": "32px",
                "lineHeight": "1.2",
