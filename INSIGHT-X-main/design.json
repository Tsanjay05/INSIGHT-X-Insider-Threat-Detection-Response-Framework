            "campaigns": "Network",
            "alerts": "Bell",
            "users": "Users",
            "timeline": "Clock",
            "policies": "Shield",
            "provenance": "Archive",
            "settings": "Settings"
        },
        "status": {
            "warning": "AlertCircle",
            "critical": "AlertTriangle",
            "success": "CheckCircle",
            "danger": "XCircle",
            "info": "Info"
        },
        "actions": {
            "view": "Eye",
            "menu": "MoreVertical",
            "filter": "Filter",
            "search": "Search",
            "refresh": "RefreshCw",
            "export": "Download"
        }
